<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_due_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/widget_due_description"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_due_name"
            android:textColor="@color/widget_primary_text"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/due_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="cursive"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/widget_coral"
            android:textSize="14sp"/>

        <ImageView
            android:id="@+id/due_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="刷新文案"
            android:padding="6dp"
            android:src="@drawable/widget_refresh"/>
    </LinearLayout>

    <TextView
        android:id="@+id/due_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:fontFamily="cursive"
        android:maxLines="4"
        android:padding="10dp"
        android:textColor="@color/widget_primary_text"
        android:textSize="21sp"/>

    <LinearLayout
        android:id="@+id/due_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/due_check_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="标记完成"
            android:padding="3dp"
            android:src="@drawable/widget_due_check"/>

        <TextView
            android:id="@+id/due_date_1"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/due_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_primary_text"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/due_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/due_check_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="标记完成"
            android:padding="3dp"
            android:src="@drawable/widget_due_check"/>

        <TextView
            android:id="@+id/due_date_2"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/due_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_primary_text"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/due_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/due_check_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="标记完成"
            android:padding="3dp"
            android:src="@drawable/widget_due_check"/>

        <TextView
            android:id="@+id/due_date_3"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/due_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_primary_text"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
