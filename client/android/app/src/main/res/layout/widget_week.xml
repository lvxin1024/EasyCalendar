<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:contentDescription="@string/widget_week_description"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_week_name"
            android:textColor="@color/widget_primary_text"
            android:textSize="15sp"/>
        <TextView
            android:id="@+id/week_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_secondary_text"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="34dp" android:layout_height="1dp"/>
        <TextView android:id="@+id/week_day_1" style="@style/EasyCalendarWidgetGridDay"/>
        <TextView android:id="@+id/week_day_2" style="@style/EasyCalendarWidgetGridDay"/>
        <TextView android:id="@+id/week_day_3" style="@style/EasyCalendarWidgetGridDay"/>
        <TextView android:id="@+id/week_day_4" style="@style/EasyCalendarWidgetGridDay"/>
        <TextView android:id="@+id/week_day_5" style="@style/EasyCalendarWidgetGridDay"/>
        <TextView android:id="@+id/week_day_6" style="@style/EasyCalendarWidgetGridDay"/>
        <TextView android:id="@+id/week_day_7" style="@style/EasyCalendarWidgetGridDay"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_grid_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"/>
</LinearLayout>
