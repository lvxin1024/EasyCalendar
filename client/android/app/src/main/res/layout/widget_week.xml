<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:contentDescription="@string/widget_week_description"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_week_name"
            android:textColor="@color/widget_primary_text"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/week_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_secondary_text"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_row_1"
        style="@style/EasyCalendarWidgetWeekRow">
        <TextView android:id="@+id/week_date_1" style="@style/EasyCalendarWidgetWeekDate"/>
        <ImageView style="@style/EasyCalendarWidgetWeekDot"/>
        <TextView android:id="@+id/week_title_1" style="@style/EasyCalendarWidgetWeekTitle"/>
        <TextView android:id="@+id/week_count_1" style="@style/EasyCalendarWidgetWeekCount"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_row_2"
        style="@style/EasyCalendarWidgetWeekRow">
        <TextView android:id="@+id/week_date_2" style="@style/EasyCalendarWidgetWeekDate"/>
        <ImageView style="@style/EasyCalendarWidgetWeekDot"/>
        <TextView android:id="@+id/week_title_2" style="@style/EasyCalendarWidgetWeekTitle"/>
        <TextView android:id="@+id/week_count_2" style="@style/EasyCalendarWidgetWeekCount"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_row_3"
        style="@style/EasyCalendarWidgetWeekRow">
        <TextView android:id="@+id/week_date_3" style="@style/EasyCalendarWidgetWeekDate"/>
        <ImageView style="@style/EasyCalendarWidgetWeekDot"/>
        <TextView android:id="@+id/week_title_3" style="@style/EasyCalendarWidgetWeekTitle"/>
        <TextView android:id="@+id/week_count_3" style="@style/EasyCalendarWidgetWeekCount"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_row_4"
        style="@style/EasyCalendarWidgetWeekRow">
        <TextView android:id="@+id/week_date_4" style="@style/EasyCalendarWidgetWeekDate"/>
        <ImageView style="@style/EasyCalendarWidgetWeekDot"/>
        <TextView android:id="@+id/week_title_4" style="@style/EasyCalendarWidgetWeekTitle"/>
        <TextView android:id="@+id/week_count_4" style="@style/EasyCalendarWidgetWeekCount"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_row_5"
        style="@style/EasyCalendarWidgetWeekRow">
        <TextView android:id="@+id/week_date_5" style="@style/EasyCalendarWidgetWeekDate"/>
        <ImageView style="@style/EasyCalendarWidgetWeekDot"/>
        <TextView android:id="@+id/week_title_5" style="@style/EasyCalendarWidgetWeekTitle"/>
        <TextView android:id="@+id/week_count_5" style="@style/EasyCalendarWidgetWeekCount"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_row_6"
        style="@style/EasyCalendarWidgetWeekRow">
        <TextView android:id="@+id/week_date_6" style="@style/EasyCalendarWidgetWeekDate"/>
        <ImageView style="@style/EasyCalendarWidgetWeekDot"/>
        <TextView android:id="@+id/week_title_6" style="@style/EasyCalendarWidgetWeekTitle"/>
        <TextView android:id="@+id/week_count_6" style="@style/EasyCalendarWidgetWeekCount"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_row_7"
        style="@style/EasyCalendarWidgetWeekRow">
        <TextView android:id="@+id/week_date_7" style="@style/EasyCalendarWidgetWeekDate"/>
        <ImageView style="@style/EasyCalendarWidgetWeekDot"/>
        <TextView android:id="@+id/week_title_7" style="@style/EasyCalendarWidgetWeekTitle"/>
        <TextView android:id="@+id/week_count_7" style="@style/EasyCalendarWidgetWeekCount"/>
    </LinearLayout>
</LinearLayout>
