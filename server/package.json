{
  "name": "@easycalendar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run test:migrations",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:migrations": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.13.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "@types/node": "22.20.1",
    "miniflare": "5.20260804.0-alpha",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  }
}
