{
  "name": "EasyCalendar",
  "version": "1.0.0",
  "description": "本地优先、可自托管的个人日程与 Due 管理工具",
  "author": "lvxin1024",
  "license": "MIT",
  "keywords": [
    "calendar",
    "event",
    "parser",
    "scheduler",
    "日程",
    "日历",
    "文本解析"
  ],
  "python_requires": ">=3.9",
  "dependencies": {
    "runtime": [
      "fastapi>=0.109.0",
      "uvicorn>=0.27.0",
      "pydantic>=2.5.3",
      "python-dateutil>=2.8.2",
      "httpx>=0.26.0",
      "google-api-python-client>=2.116.0",
      "msal>=1.26.0",
      "icalendar>=5.0.11",
      "python-multipart>=0.0.6",
      "PyYAML>=6.0.1",
      "python-dotenv>=1.0.0"
    ],
    "dev": [
      "pytest>=7.4.4",
      "pytest-asyncio>=0.23.3"
    ]
  }
}
